/target
**/target/
.codex
.agent/
.agents/

# JetBrains Rider
*.sln.iml
# JetBrains Rider / IntelliJ IDEA
.idea/*
# Shared project settings
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/runConfigurations/
!.idea/vcs.xml
!.idea/modules.xml
!.idea/*.iml
# Ignore user workspace-level files
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
*.iws
*.sln.DotSettings.user
*.user

AGENTS.md
GEMINI.md
CLAUDE.md
agent_*.md
check*.txt
ai_check.sh

logs/
dev/
dev_review/

# System
.DS_Store
Thumbs.db

# Node
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

ignore_music.wav
assets/builtins/

reports/
generated/*
!generated/.gitignore

# Ignore .cargo/ except audit.toml and config.toml (needed for CI)
.cargo/*
!.cargo/audit.toml
!.cargo/config.toml

# Ignore .cargo/ in mod examples (local dev config for cross-compilation)
projects/**/code/**/.cargo/

# Local lockfiles for standalone example / fixture crates
projects/**/code/**/Cargo.lock
crates/**/tests/fixtures/**/Cargo.lock


# Legacy local mod repository cache
.mod-repo/
# Android build artifacts
android/.gradle/
android/souprune/build/
android/souprune/src/main/jniLibs/
android/build/

# Project mods (local user projects are ignored; maintained examples are git submodules)
projects/*/
!projects/config.toml
!projects/undertale_preset/
!projects/mad_dummy_example/
!projects/deltarune_preset/

# Local work directories
.worktrees/
.workbench/
.tmp/
