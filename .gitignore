/target

# JetBrains Rider
*.sln.iml
# JetBrains Rider / IntelliJ IDEA
.idea/*
# Shared project settings
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/runConfigurations/
!.idea/vcs.xml
!.idea/modules.xml
!.idea/*.iml
# Ignore user workspace-level files
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
*.iws
*.sln.DotSettings.user
*.user

AGENTS.md
GEMINI.md
agent_*.md
check*.txt
ai_check.sh

logs/
dev/
dev_review/

# System
.DS_Store
Thumbs.db

# Node
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

ignore_music.wav

reports/
generated/*
!generated/.gitignore

# Ignore .cargo/ except audit.toml and config.toml (needed for CI)
.cargo/*
!.cargo/audit.toml
!.cargo/config.toml

# Ignore .cargo/ in mod examples (local dev config for cross-compilation)
projects/**/code/**/.cargo/


# Mod repo worktree manager
.mod-repo/
# Android build artifacts
android/.gradle/
android/app/build/
android/app/src/main/jniLibs/
android/build/

# Project mods (each is its own repo/branch, only config.toml tracked)
projects/*/
!projects/config.toml

# Local work directories
.workbench/
.tmp/
