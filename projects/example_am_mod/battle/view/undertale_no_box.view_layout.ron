                )),
            ),
        ),

        // HUD Info
        (
            name: "BattleHUD",
            texts: [
                (
                    id: "PlayerName",
                    content: "{$player_name}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-290.0, -155.5, 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelLabel",
                    content: "{{battle/ui:LV}}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-187.5, -155.5, 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelValue",
                    content: "{$player_lv}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-148.5, -155.5, 1.0),
                    ),
                ),
                (
