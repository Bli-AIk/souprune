#![enable(implicit_some)]
// Battle View Layout for example_am_mod (standard Undertale UI)
// 示例 AM mod 的战斗视图布局（标准 Undertale UI）
//
// NOTE: This mod uses AM animation system for battle box.
// For full FRE navigation example, see example_mod.
// 注意：此 mod 使用 AM 动画系统来处理战斗框。
// 完整的 FRE 导航示例请参考 example_mod。

(
    // View-local facts for basic state
    // 基础状态的 View 局部事实
    facts: {
        "button_selection": 0,
    },

    roots: [
        // Battle Box (Dialog/Bullet Box)
        (
            name: "BattleBox",
            tags: ["BattleBox"],
            view_box: (
                width: 566.0,
                height: 130.0,
                border_width: 5.0,
                offset: (0.0, -80.0, 0.0),
                structure_file: "shared/view_structures/view_box.sdf.ron",
            ),
            children: [],
        ),

        // Fight Button
        (
            name: "BtnFight",
            sprite: (
                visual: "assets/textures/battle/view/fight/false.png",
                transform: (
                    translation: (-233.0, -213.0, 1.0),
                ),
            ),
        ),
        (
            name: "BtnFightSelected",
            visible_when: "$button_selection == 0",
            sprite: (
                visual: "assets/textures/battle/view/fight/true.png",
                transform: (
                    translation: (-233.0, -213.0, 1.5),
                ),
            ),
        ),

        // Act Button
        (
            name: "BtnAct",
            sprite: (
                visual: "assets/textures/battle/view/act/false.png",
                transform: (
                    translation: (-80.0, -213.0, 1.0),
                ),
            ),
        ),
        (
            name: "BtnActSelected",
            visible_when: "$button_selection == 1",
            sprite: (
                visual: "assets/textures/battle/view/act/true.png",
                transform: (
                    translation: (-80.0, -213.0, 1.5),
                ),
            ),
        ),

        // Item Button
        (
            name: "BtnItem",
            sprite: (
                visual: "assets/textures/battle/view/item/false.png",
                transform: (
                    translation: (80.0, -213.0, 1.0),
                ),
            ),
        ),
        (
            name: "BtnItemSelected",
            visible_when: "$button_selection == 2",
            sprite: (
                visual: "assets/textures/battle/view/item/true.png",
                transform: (
                    translation: (80.0, -213.0, 1.5),
                ),
            ),
        ),

        // Mercy Button
        (
            name: "BtnMercy",
            sprite: (
                visual: "assets/textures/battle/view/mercy/false.png",
                transform: (
                    translation: (235.0, -213.0, 1.0),
                ),
            ),
        ),
        (
            name: "BtnMercySelected",
            visible_when: "$button_selection == 3",
            sprite: (
                visual: "assets/textures/battle/view/mercy/true.png",
                transform: (
                    translation: (235.0, -213.0, 1.5),
                ),
            ),
        ),

        // HUD Info
        (
            name: "BattleHUD",
            texts: [
                (
                    id: "PlayerName",
                    content: "{$player_name}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-290.0, -155.5, 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelLabel",
                    content: "{{battle/ui:LV}}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-187.5, -155.5, 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelValue",
                    content: "{$player_lv}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-148.5, -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPValueCurrent",
                    content: "{$player_hp}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("-5.5 + ($player_hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPSeparator",
                    content: "/",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("33.5 + ($player_hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPValueMax",
                    content: "{$player_hp_max}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("57.5 + ($player_hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
            ],
            children: [
                (
                    name: "HPSprite",
                    sprite: (
                        visual: "assets/textures/battle/view/hpname.png",
                        transform: (
                            translation: (-64.5, -170.0, 1.0),
                        ),
                    ),
                ),
                (
                    name: "HPBar",
                    sprite: (
                        visual: "procedural://white_pixel",
                        transform: (
                            translation: (-45.0, -170.5, 1.0),
                            scale: ("25.0 + ($player_hp_max - 20) * 95.0 / 79", 20.5, 1.0),
                        ),
                        material: (
                            shader: "shared/shaders/hp_bar_sprite.wgsl",
                            params: {
                                "hp_ratio": Expr("$player_hp / $player_hp_max"),
                                "lag_ratio": Static(1.0),
                                "half_width": Expr("40.0 + ($player_hp_max - 20) * 95.0 / 79 / 2"),
                                "alpha": Static(1.0),
                            },
                            animations: (
                                lag: (
                                    source: "hp_ratio",
                                    target: "lag_ratio",
                                    delay: 0.2,
                                    duration: 0.4,
                                    easing: OutCirc,
                                ),
                            ),
                        ),
                        pivot: (0.0, 0.5),
                    ),
                )
            ],
        ),
    ]
)
