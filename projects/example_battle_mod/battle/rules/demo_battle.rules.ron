#![enable(implicit_some)]
// Demo FRE Rules for Battle System
// 战斗系统的演示 FRE 规则
//
// This file demonstrates the data-driven battle rule system with FRE integration.
// It shows how to use facts for turn counting, HP tracking, and conditional logic.
//
// 此文件演示与 FRE 集成的数据驱动战斗规则系统。
// 展示如何使用事实进行回合计数、HP 跟踪和条件逻辑。
//
// Key concepts:
// - Turn counting via `battle_turn_count` fact
// - HP thresholds for dialogue triggers
// - Phase transitions via events
//
// 核心概念：
// - 通过 `battle_turn_count` 事实进行回合计数
// - 基于 HP 阈值触发对话
// - 通过事件进行阶段转换

(
    version: 1,

    // Initial facts to set when this rule set is loaded
    // These are LOCAL layer facts specific to this battle
    // 加载此规则集时设置的初始事实
    // 这些是此战斗特定的局部层事实
    initial_facts: {
        "battle_turn_count": Int(0),
        "battle_phase": String("initializing"),
        "enemy_0_hp": Int(100),
        "enemy_0_hp_max": Int(100),
        "enemy_0_atk": Int(10),
        "enemy_0_def": Int(5),
        "enemy_0_mercy_value": Int(0),
    },

    rules: [
        // === Turn Management Rules ===
        // === 回合管理规则 ===

        // Rule: Increment turn counter when turn starts
        // 规则：回合开始时增加回合计数器
        (
            id: "increment_turn_count",
            trigger: "turn_started",
            condition: Always,
            modifications: [
                Increment(key: "battle_turn_count", amount: 1),
            ],
            actions: [
                Log(message: "Turn started"),
            ],
            outputs: ["turn_count_updated"],
            priority: 10,
        ),

        // === HP Threshold Rules ===
        // === HP 阈值规则 ===

        // Rule: Trigger special dialogue when enemy HP drops below 50%
        // 规则：当敌人 HP 低于 50% 时触发特殊对话
        (
            id: "enemy_hp_half_dialogue",
            trigger: "enemy_damaged",
            condition: LessOrEqual(key: "enemy_0_hp", value: 50),
            actions: [
                Log(message: "Enemy HP below 50%! Triggering dialogue."),
                Custom(action_type: "TriggerDialogue", params: {
                    "dialogue_id": "enemy_half_hp_taunt",
                }),
            ],
            outputs: ["enemy_hp_threshold_reached"],
            priority: 5,
            once: true,  // Only trigger once per battle
        ),

        // Rule: Enemy death check
        // 规则：敌人死亡检查
        (
            id: "enemy_death_check",
            trigger: "enemy_damaged",
            condition: LessOrEqual(key: "enemy_0_hp", value: 0),
            actions: [
                Log(message: "Enemy defeated!"),
                Custom(action_type: "EndBattle", params: {
                    "result": "victory",
                }),
            ],
            outputs: ["enemy_killed"],
            priority: 100,
        ),

        // === Turn-based Dialogue Rules ===
        // === 基于回合的对话规则 ===

        // Rule: Trigger dialogue on turn 3
        // 规则：在第3回合触发对话
        (
            id: "turn_3_dialogue",
            trigger: "turn_count_updated",
            condition: Equals(key: "battle_turn_count", value: Int(3)),
            actions: [
                Log(message: "Turn 3 reached! Boss starts taunting."),
                Custom(action_type: "TriggerDialogue", params: {
                    "dialogue_id": "turn_3_boss_taunt",
                }),
            ],
            outputs: ["turn_milestone_reached"],
            priority: 5,
        ),

        // === Mercy System Rules ===
        // === 饶恕系统规则 ===

        // Rule: Increment mercy value on ACT
        // 规则：在 ACT 时增加饶恕值
        (
            id: "increment_mercy_on_act",
            trigger: "player_action_act",
            condition: Always,
            modifications: [
                Increment(key: "enemy_0_mercy_value", amount: 10),
            ],
            actions: [
                Log(message: "Mercy value increased by 10"),
            ],
            outputs: ["mercy_updated"],
            priority: 5,
        ),

        // Rule: Enemy can be spared when mercy value reaches 100
        // 规则：当饶恕值达到 100 时敌人可被饶恕
        (
            id: "enemy_spareable_check",
            trigger: "mercy_updated",
            condition: GreaterOrEqual(key: "enemy_0_mercy_value", value: 100),
            modifications: [
                Set(key: "enemy_0_spareable", value: Bool(true)),
            ],
            actions: [
                Log(message: "Enemy can now be spared!"),
            ],
            outputs: ["enemy_spareable"],
            priority: 5,
            once: true,
        ),
    ],
)
