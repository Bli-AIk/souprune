#![enable(implicit_some)]
// Demo Battle Rules - turn counting, HP thresholds, mercy system

(
    facts: {
        "battle_turn_count": Int(0),
        "battle_phase": String("initializing"),
        "enemy_0_hp": Int(100), "enemy_0_hp_max": Int(100),
        "enemy_0_atk": Int(10), "enemy_0_def": Int(5), "enemy_0_mercy_value": Int(0),
    },

    rules: [
        // Turn management
        (id: "increment_turn_count", trigger: "turn_started", condition: Always,
         modifications: [Increment(key: "battle_turn_count", amount: 1)],
         outputs: ["turn_count_updated"], priority: 10),

        // HP thresholds
        (id: "enemy_hp_half_dialogue", trigger: "enemy_damaged",
         condition: LessOrEqual(key: "enemy_0_hp", value: 50),
         actions: [Custom(action_type: "TriggerDialogue", params: { "dialogue_id": "enemy_half_hp_taunt" })],
         outputs: ["enemy_hp_threshold_reached"], priority: 5, once: true),

        (id: "enemy_death_check", trigger: "enemy_damaged",
         condition: LessOrEqual(key: "enemy_0_hp", value: 0),
         actions: [Custom(action_type: "EndBattle", params: { "result": "victory" })],
         outputs: ["enemy_killed"], priority: 100),

        // Turn-based dialogue
        (id: "turn_3_dialogue", trigger: "turn_count_updated",
         condition: Equals(key: "battle_turn_count", value: Int(3)),
         actions: [Custom(action_type: "TriggerDialogue", params: { "dialogue_id": "turn_3_boss_taunt" })],
         outputs: ["turn_milestone_reached"], priority: 5),

        // Mercy system
        (id: "increment_mercy_on_act", trigger: "player_action_act", condition: Always,
         modifications: [Increment(key: "enemy_0_mercy_value", amount: 10)],
         outputs: ["mercy_updated"], priority: 5),

        (id: "enemy_spareable_check", trigger: "mercy_updated",
         condition: GreaterOrEqual(key: "enemy_0_mercy_value", value: 100),
         modifications: [Set(key: "enemy_0_spareable", value: Bool(true))],
         outputs: ["enemy_spareable"], priority: 5, once: true),
    ],
)
