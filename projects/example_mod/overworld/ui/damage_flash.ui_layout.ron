// Chase mode damage HUD UI (HP bar and HP text)
// 追逐战模式受伤 HUD UI（血条和血量文字）
// Uses Battle UI style HP bar and text layout with high Z for top visibility
// 使用 Battle UI 风格的血条和文字布局，高 Z 值确保显示在最顶层
(
    version: 1,
    roots: [
        // HUD Info - Pure container node with HP bar and HP text
        // HUD 信息 - 带有血条和血量文字的纯容器节点
        (
            name: "ChaseHUD",
            camera_anchored: true,
            texts: [
                (
                    id: "PlayerName",
                    content: Some("{@player.name}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -290.0, y: -195.5, z: 501.0),
                    ),
                ),
                (
                    id: "PlayerLevelLabel",
                    content: Some("{{battle/ui:LV}}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -187.5, y: -195.5, z: 501.0),
                    ),
                ),
                (
                    id: "PlayerLevelValue",
                    content: Some("{@player.lv}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -148.5, y: -195.5, z: 501.0),
                    ),
                ),
                (
                    id: "HPValueCurrent",
                    content: Some("{@player.hp}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "-5.5 + (@player.hp_max - 20) * 94.5 / 79", y: -195.5, z: 501.0),
                    ),
                ),
                (
                    id: "HPSeparator",
                    content: Some("/"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "33.5 + (@player.hp_max - 20) * 94.5 / 79", y: -195.5, z: 501.0),
                    ),
                ),
                (
                    id: "HPValueMax",
                    content: Some("{@player.hp_max}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "57.5 + (@player.hp_max - 20) * 94.5 / 79", y: -195.5, z: 501.0),
                    ),
                ),
            ],
            children: [
                (
                    name: "HPSprite",
                    sprite: Some((
                        path: "textures/battle/ui/hpname.png",
                        is_animation: false,
                        transform: Some((
                            translation: (x: -64.5, y: -210.0, z: 501.0),
                        )),
                    )),
                ),
                (
                    name: "HPBar",
                    sprite: Some((
                        path: "procedural://white_pixel",
                        is_animation: false,
                        transform: Some((
                            translation: (x: -45.0, y: -210.5, z: 501.0),
                            scale: Some((x: "25.0 + (@player.hp_max - 20) * 95.0 / 79", y: 20.5, z: 1.0)),
                        )),
                        custom_shader: Some("shaders/hp_bar_sprite.wgsl"),
                        shader_params: Some((r: 0.8, g: 0.8, b: "40.0 + (@player.hp_max - 20) * 95.0 / 79 / 2", a: 1.0)),
                        pivot: Some((x: 0.0, y: 0.5)),
                    )),
                ),
            ],
        ),
    ]
)
