// Chase mode damage HUD UI (HP bar and HP text)
// 追逐战模式受伤 HUD UI（血条和血量文字）
// Adjusted for Overworld resolution (smaller visible area than Battle)
// 针对 Overworld 分辨率调整（可见区域比 Battle 小）
// With resolution_scale=2, visible area is ±160x±120
// 当 resolution_scale=2 时，可见区域为 ±160x±120
(
    version: 1,
    roots: [
        // HUD Info - Pure container node with HP bar and HP text
        // HUD 信息 - 带有血条和血量文字的纯容器节点
        (
            name: "ChaseHUD",
            camera_anchored: true,
            texts: [
                (
                    id: "PlayerName",
                    content: Some("{@player.name}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -145.0, y: -97.0, z: 501.0),
                    ),
                ),
                (
                    id: "PlayerLevelLabel",
                    content: Some("{{battle/ui:LV}}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -93.0, y: -97.0, z: 501.0),
                    ),
                ),
                (
                    id: "PlayerLevelValue",
                    content: Some("{@player.lv}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -74.0, y: -97.0, z: 501.0),
                    ),
                ),
                (
                    id: "HPValueCurrent",
                    content: Some("{@player.hp}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "-3.0 + (@player.hp_max - 20) * 47.0 / 79", y: -97.0, z: 501.0),
                    ),
                ),
                (
                    id: "HPSeparator",
                    content: Some("/"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "17.0 + (@player.hp_max - 20) * 47.0 / 79", y: -97.0, z: 501.0),
                    ),
                ),
                (
                    id: "HPValueMax",
                    content: Some("{@player.hp_max}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "29.0 + (@player.hp_max - 20) * 47.0 / 79", y: -97.0, z: 501.0),
                    ),
                ),
            ],
            children: [
                (
                    name: "HPSprite",
                    sprite: Some((
                        path: "textures/battle/ui/hpname.png",
                        is_animation: false,
                        transform: Some((
                            translation: (x: -32.0, y: -105.0, z: 501.0),
                        )),
                    )),
                ),
                (
                    name: "HPBar",
                    sprite: Some((
                        path: "procedural://white_pixel",
                        is_animation: false,
                        transform: Some((
                            translation: (x: -22.0, y: -105.0, z: 501.0),
                            scale: Some((x: "12.5 + (@player.hp_max - 20) * 47.5 / 79", y: 10.0, z: 1.0)),
                        )),
                        custom_shader: Some("shaders/hp_bar_sprite.wgsl"),
                        shader_params: Some((r: 0.8, g: 0.8, b: "20.0 + (@player.hp_max - 20) * 47.5 / 79 / 2", a: 1.0)),
                        pivot: Some((x: 0.0, y: 0.5)),
                    )),
                ),
            ],
        ),
    ]
)
