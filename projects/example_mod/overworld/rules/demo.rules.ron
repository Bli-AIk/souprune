// Demo FRE Rules for Overworld (Experimental Feature)
// 演示 Overworld 的 FRE 规则（实验性功能）
//
// This file demonstrates the data-driven rule system with danmaku integration.
// Walk into the trigger zone to trigger a danmaku performance immediately.
//
// 此文件演示数据驱动的规则系统与弹幕系统的整合。
// 走进触发区域将立即触发弹幕演出。

(
    version: 1,

    // Initial facts to set when this rule set is loaded
    // 加载此规则集时设置的初始事实
    initial_facts: {
        "demo_area_visit_count": Int(0),
    },

    rules: [
        // Rule 1: Increment counter and trigger danmaku on every trigger entry
        // 规则 1：每次进入触发器时增加计数器并触发弹幕
        (
            id: "demo_increment_visit",
            trigger: "trigger_enter_demo_trigger",
            condition: Always,
            modifications: [
                Increment(key: "demo_area_visit_count", amount: 1),
            ],
            actions: [
                Log(message: "Player entered trigger zone - spawning danmaku!"),
            ],
            outputs: ["demo_visit_updated"],
            priority: 10,
        ),
    ],
)
