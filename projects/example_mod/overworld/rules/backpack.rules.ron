#![enable(implicit_some)]
// Backpack Navigation Rules (FRE-based)
// 背包导航规则（基于 FRE）
//
// This file demonstrates the new FRE-based navigation system that replaces
// the old interactive_layers system. It uses View local facts to track state.
//
// 此文件演示新的基于 FRE 的导航系统，替代旧的 interactive_layers 系统。
// 它使用 View 局部事实来跟踪状态。
//
// MIGRATION GUIDE / 迁移指南:
//
// Old system (interactive_layers):
//   - Uses hardcoded layer names: "BackpackMenu", "BackpackItem", etc.
//   - Visibility controlled by: visibility_rule: { rule_type: "OnlyIn", layers: [...] }
//   - Navigation via: GotoLayer("LayerName")
//
// New system (FRE + local facts):
//   - Uses numeric `depth` fact: 0=Menu, 1=Item, 2=ItemOptions, 3=Status
//   - Visibility controlled by: visible_when: "$depth == 1"
//   - Navigation via: Set("depth", 1) modification

(
    version: 1,

    // Initial facts - these are VIEW-LOCAL facts
    // When the Backpack View is spawned, these facts are copied to ViewRoot.local_facts
    // They are automatically cleaned up when the View is despawned
    //
    // 初始事实 - 这些是 VIEW-LOCAL 事实
    // 当背包 View 生成时，这些事实会被复制到 ViewRoot.local_facts
    // 当 View 被销毁时，它们会自动清理
    initial_facts: {
        // Current navigation depth
        // 当前导航深度
        // 0 = BackpackMenu (ITEM/STAT selection)
        // 1 = BackpackItem (item list)
        // 2 = BackpackItemOptions (USE/INFO/DROP)
        // 3 = BackpackStatus (player stats)
        "depth": Int(0),

        // Selection index at each depth level
        // 每个深度级别的选择索引
        "selection_0": Int(0),  // Menu selection: 0=ITEM, 1=STAT
        "selection_1": Int(0),  // Item list selection
        "selection_2": Int(0),  // Item options: 0=USE, 1=INFO, 2=DROP
        
        // Current active selection (alias for depth-specific selection)
        // 当前活动选择（深度特定选择的别名）
        "selection": Int(0),

        // Whether the backpack view is active
        // 背包视图是否活跃
        "active": Bool(true),
    },

    rules: [
        // === NAVIGATION RULES / 导航规则 ===

        // Rule: Navigate up in menu
        // 规则：在菜单中向上导航
        (
            id: "backpack_nav_up",
            trigger: "input_nav_up",
            condition: And([
                Equals(key: "active", value: Bool(true)),
                GreaterThan(key: "selection", value: Int(0)),
            ]),
            modifications: [
                Decrement(key: "selection", amount: 1),
            ],
            actions: [
                Custom(action_type: "PlaySound", params: { "path": "choice.wav" }),
            ],
            priority: 10,
        ),

        // Rule: Navigate down in menu (depth 0, max 1)
        // 规则：在菜单中向下导航（深度 0，最大 1）
        (
            id: "backpack_nav_down_menu",
            trigger: "input_nav_down",
            condition: And([
                Equals(key: "active", value: Bool(true)),
                Equals(key: "depth", value: Int(0)),
                LessThan(key: "selection", value: Int(1)),
            ]),
            modifications: [
                Increment(key: "selection", amount: 1),
            ],
            actions: [
                Custom(action_type: "PlaySound", params: { "path": "choice.wav" }),
            ],
            priority: 10,
        ),

        // Rule: Navigate down in item list (depth 1, max = inventory.len - 1)
        // 规则：在物品列表中向下导航（深度 1，最大 = 背包长度 - 1）
        (
            id: "backpack_nav_down_items",
            trigger: "input_nav_down",
            condition: And([
                Equals(key: "active", value: Bool(true)),
                Equals(key: "depth", value: Int(1)),
                // Note: max bound would need dynamic evaluation
                // 注意：最大边界需要动态评估
            ]),
            modifications: [
                Increment(key: "selection", amount: 1),
            ],
            actions: [
                Custom(action_type: "PlaySound", params: { "path": "choice.wav" }),
            ],
            priority: 10,
        ),

        // === CONFIRM/CANCEL RULES / 确认/取消规则 ===

        // Rule: Confirm on menu - go to ITEM layer (depth 0 -> 1)
        // 规则：在菜单确认 - 进入物品层（深度 0 -> 1）
        (
            id: "backpack_confirm_to_item",
            trigger: "input_confirm",
            condition: And([
                Equals(key: "depth", value: Int(0)),
                Equals(key: "selection", value: Int(0)),
                // Need: player.inventory.is_not_empty
            ]),
            modifications: [
                Set(key: "depth", value: Int(1)),
                Set(key: "selection", value: Int(0)),
            ],
            actions: [
                Custom(action_type: "PlaySound", params: { "path": "confirm.wav" }),
            ],
            outputs: ["depth_changed"],
            priority: 10,
        ),

        // Rule: Confirm on menu - go to STATUS layer (depth 0 -> 3)
        // 规则：在菜单确认 - 进入状态层（深度 0 -> 3）
        (
            id: "backpack_confirm_to_status",
            trigger: "input_confirm",
            condition: And([
                Equals(key: "depth", value: Int(0)),
                Equals(key: "selection", value: Int(1)),
            ]),
            modifications: [
                Set(key: "depth", value: Int(3)),
            ],
            actions: [
                Custom(action_type: "PlaySound", params: { "path": "confirm.wav" }),
            ],
            outputs: ["depth_changed"],
            priority: 10,
        ),

        // Rule: Confirm on item list - go to options (depth 1 -> 2)
        // 规则：在物品列表确认 - 进入选项（深度 1 -> 2）
        (
            id: "backpack_confirm_to_options",
            trigger: "input_confirm",
            condition: Equals(key: "depth", value: Int(1)),
            modifications: [
                Set(key: "depth", value: Int(2)),
                Set(key: "selection", value: Int(0)),
            ],
            actions: [
                Custom(action_type: "PlaySound", params: { "path": "confirm.wav" }),
            ],
            outputs: ["depth_changed"],
            priority: 10,
        ),

        // Rule: Cancel from item list - back to menu (depth 1 -> 0)
        // 规则：从物品列表取消 - 返回菜单（深度 1 -> 0）
        (
            id: "backpack_cancel_from_items",
            trigger: "input_cancel",
            condition: Equals(key: "depth", value: Int(1)),
            modifications: [
                Set(key: "depth", value: Int(0)),
                // Restore previous menu selection
            ],
            outputs: ["depth_changed"],
            priority: 10,
        ),

        // Rule: Cancel from options - back to item list (depth 2 -> 1)
        // 规则：从选项取消 - 返回物品列表（深度 2 -> 1）
        (
            id: "backpack_cancel_from_options",
            trigger: "input_cancel",
            condition: Equals(key: "depth", value: Int(2)),
            modifications: [
                Set(key: "depth", value: Int(1)),
            ],
            outputs: ["depth_changed"],
            priority: 10,
        ),

        // Rule: Cancel from status - back to menu (depth 3 -> 0)
        // 规则：从状态取消 - 返回菜单（深度 3 -> 0）
        (
            id: "backpack_cancel_from_status",
            trigger: "input_cancel",
            condition: Equals(key: "depth", value: Int(3)),
            modifications: [
                Set(key: "depth", value: Int(0)),
            ],
            outputs: ["depth_changed"],
            priority: 10,
        ),

        // Rule: Cancel from menu - close backpack (depth 0)
        // 规则：从菜单取消 - 关闭背包（深度 0）
        (
            id: "backpack_close",
            trigger: "input_cancel",
            condition: Equals(key: "depth", value: Int(0)),
            modifications: [
                Set(key: "active", value: Bool(false)),
            ],
            actions: [
                Custom(action_type: "PopState", params: {}),
            ],
            priority: 10,
        ),
    ],
)
