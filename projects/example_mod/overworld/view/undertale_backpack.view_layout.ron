#![enable(implicit_some)]
(
    // Query the API documentation for this file in layout.rs.
    //
    // 在 layout.rs 查询此文件的 API 文档。
    version: 1,
    roots: [
        // Menu Box (ITEM/STAT)
        (
            name: "MenuBox",
            ui_shape_logic: (
                width: 65.0,
                height: 68.0,
                border_width: 3.0,
                offset: (-108.5, -1.0, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            visibility_rule: (
                rule_type: "Always",
                layers: None,
            ),
            texts: [
                (
                    id: "MenuTextItem",
                    content: "{{overworld/ui:ITEM}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-9.5, 28.25, 1.0),
                    ),
                    line_height: 1.375,
                    conditional_style: (
                        condition: "player.inventory.is_empty",
                        color: (0.5, 0.5, 0.5, 1.0),
                    ),
                ),
                (
                    id: "MenuTextStat",
                    content: "{{overworld/ui:STAT}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-9.5, 10.25, 1.0),
                    ),
                    line_height: 1.375,
                ),
            ],
            cursor: (
                sprite_path: "common/heartsmall",
                default_translation: Some(Linear(
                    origin: (-19.0, 18.5, 2.0),
                    step: (0.0, -18.0, 0.0),
                )),
                overrides: {},
                visibility_rule: (
                    rule_type: "OnlyIn",
                    layers: ["BackpackMenu"],
                ),
                transform: (
                ),
            ),
            children: [],
        ),
        // Info Box (Name, LV, HP, Gold)
        (
            name: "InfoBox",
            ui_shape_logic: (
                width: 65.0,
                height: 49.0,
                border_width: 3.0,
                offset: (-108.5, "if(player.y > camera.y, -68.5, 66.5)", 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            visibility_rule: (
                rule_type: "Always",
                layers: None,
            ),
            texts: [
                (
                    id: "NameText",
                    content: "{@player.name}",
                    font: DeterminationSans,
                    world_scale: (13.0, 13.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-28.5, 22.0, 1.0),
                    ),
                    line_height: 1.0,
                ),
                (
                    id: "HUDText",
                    content: "{{overworld/ui:LV}}  {@player.lv}\n{{overworld/ui:HP}}  {@player.hp}/{@player.hp_max}\ng   {@player.gold}",
                    font: Hud,
                    world_scale: (8.0, 8.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-28.5, 5.75, 1.0),
                    ),
                    line_height: 1.125,
                ),
            ],
            children: [],
        ),
        // Item Box (Item list and USE/INFO/DROP)
        (
            name: "ItemBox",
            ui_shape_logic: (
                width: 167.0,
                height: 175.0,
                border_width: 3.0,
                offset: (20.5, 3.5, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            visibility_rule: (
                rule_type: "OnlyIn",
                layers: ["BackpackItem", "BackpackItemOptions"],
            ),
            texts: [
                (
                    id: "ItemLayerList",
                    content: "{@player.inventory}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-64.25, 76.5, 1.0),
                    ),
                    line_height: 1.2,
                ),
                (
                    id: "ItemLayerOptionUse",
                    content: "{{overworld/ui:USE}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-64.25, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                ),
                (
                    id: "ItemLayerOptionInfo",
                    content: "{{overworld/ui:INFO}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-12.25, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                ),
                (
                    id: "ItemLayerOptionDrop",
                    content: "{{overworld/ui:DROP}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (40.75, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                ),
            ],
            cursor: (
                sprite_path: "common/heartsmall",
                default_translation: Some(Linear(
                    origin: (-72.0, 68.0, 2.0),
                    step: (0.0, -16.0, 0.0),
                )),
                overrides: {
                    "BackpackItemOptions": Custom(
                        positions: [
                            (-72.0, -72.0, 2.0),
                            (-24.0, -72.0, 2.0),
                            (33.0, -72.0, 2.0),
                        ],
                    ),
                },
                visibility_rule: (
                    rule_type: "OnlyIn",
                    layers: ["BackpackItem", "BackpackItemOptions"],
                ),
                transform: Some((
                    scale: (1.0, 1.0, 1.0),
                    rotation: 0.0,
                )),
            ),
            children: [],
        ),
        // Status Box (Detailed stats)
        (
            name: "StatusBox",
            ui_shape_logic: (
                width: 167.0,
                height: 202.5,
                border_width: 3.0,
                offset: (20.5, -10.5, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            visibility_rule: (
                rule_type: "OnlyIn",
                layers: ["BackpackStatus"],
            ),
            texts: [
                (
                    id: "StatusLayerName",
                    content: "\"{@player.name}\"",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 88.25, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerLvHp",
                    content: "{{overworld/ui:LV}}   {@player.lv}\n{{overworld/ui:HP}}  {@player.hp} / {@player.hp_max}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 57.75, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerCombat",
                    content: "{{overworld/ui:ATK}}  {@player.total_attack} ({@player.weapon_atk})            {{overworld/ui:EXP}}: {@player.exp}\n{{overworld/ui:DEF}}  {@player.total_defense} ({@player.armor_def})            {{overworld/ui:NEXT}}: {@player.next_exp}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 10.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerEquipment",
                    content: "{{overworld/ui:WEAPON}}: {@player.weapon}\n{{overworld/ui:ARMOR}}: {@player.armor}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, -36.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerGold",
                    content: "{{overworld/ui:GOLD}}: {@player.gold}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, -72.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
            ],
            children: [],
        ),
    ],
    global_triggers: {
        "Menu": [
            (
                target_state: "Backpack",
                sound: "choice.wav",
                allowed_states: ["Normal"],
            ),
            (
                target_state: "Normal",
                sound: None,
                allowed_states: ["Backpack"],
            ),
        ],
    },
    navigation: {
        "BackpackMenu": (
            mappings: {
                "Up": -1,
                "Down": 1,
            },
            looping: false,
            min_index: 0,
            max_index: 2,
            sound_on_navigate: "choice.wav",
        ),
        "BackpackItem": (
            mappings: {
                "Up": -1,
                "Down": 1,
            },
            looping: false,
            min_index: 0,
            max_index: Some("min(inventory.len(), inventory_capacity)"),
            sound_on_navigate: "choice.wav",
        ),
        "BackpackItemOptions": (
            mappings: {
                "Left": -1,
                "Right": 1,
            },
            looping: false,
            min_index: 0,
            max_index: 3,
            sound_on_navigate: "choice.wav",
        ),
        "BackpackStatus": (
            mappings: {},
            looping: false,
            min_index: 0,
            max_index: 1,
        ),
    },
    transitions: {
        "BackpackMenu": (
            on_confirm: Some([
                (
                    condition: "index == 0 && !player.inventory.is_empty",
                    action: GotoLayer("BackpackItem"),
                ),
                (
                    condition: "index == 1",
                    action: GotoLayer("BackpackStatus"),
                ),
            ]),
            on_cancel: PopState,
            sound_on_confirm: "confirm.wav",
            sound_on_cancel: None,
        ),
        "BackpackItem": (
            on_confirm: Some([
                (
                    condition: None,
                    action: GotoLayer("BackpackItemOptions"),
                ),
            ]),
            on_cancel: Some(GotoLayer("BackpackMenu")),
            sound_on_confirm: "confirm.wav",
            sound_on_cancel: None,
        ),
        "BackpackItemOptions": (
            on_confirm: None,
            on_cancel: Some(GotoLayer("BackpackItem")),
            sound_on_confirm: "confirm.wav",
            sound_on_cancel: None,
        ),
        "BackpackStatus": (
            on_confirm: None,
            on_cancel: Some(GotoLayer("BackpackMenu")),
            sound_on_confirm: "confirm.wav",
            sound_on_cancel: None,
        ),
    },
    // New unified interactive layer system (Phase 7)
    // 新的统一交互层系统（Phase 7）
    interactive_layers: {
        "BackpackMenu": (
            navigator_type: Linear(
                direction: Vertical,
                option_count: 2,
                looping: false,
            ),
            selectable_elements: [],
            sound_on_navigate: "choice.wav",
            on_confirm: [
                (
                    condition: "index == 0 && !player.inventory.is_empty",
                    action: GotoLayer("BackpackItem"),
                ),
                (
                    condition: "index == 1",
                    action: GotoLayer("BackpackStatus"),
                ),
            ],
            on_cancel: PopState,
            sound_on_confirm: "confirm.wav",
        ),
        "BackpackItem": (
            navigator_type: Linear(
                direction: Vertical,
                option_count: 8,  // Will be clamped to actual inventory size
                looping: false,
            ),
            selectable_elements: [],
            sound_on_navigate: "choice.wav",
            on_confirm: [
                (
                    action: GotoLayer("BackpackItemOptions"),
                ),
            ],
            on_cancel: GotoLayer("BackpackMenu"),
            sound_on_confirm: "confirm.wav",
        ),
        "BackpackItemOptions": (
            navigator_type: Linear(
                direction: Horizontal,
                option_count: 3,
                looping: false,
            ),
            selectable_elements: ["ItemLayerOptionUse", "ItemLayerOptionInfo", "ItemLayerOptionDrop"],
            sound_on_navigate: "choice.wav",
            on_cancel: GotoLayer("BackpackItem"),
            sound_on_confirm: "confirm.wav",
        ),
        "BackpackStatus": (
            navigator_type: Linear(
                direction: Vertical,
                option_count: 1,
                looping: false,
            ),
            selectable_elements: [],
            on_cancel: GotoLayer("BackpackMenu"),
            sound_on_confirm: "confirm.wav",
        ),
    },
)