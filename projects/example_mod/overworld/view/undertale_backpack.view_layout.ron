#![enable(implicit_some)]
// Undertale Backpack View Layout - NEW FRE-BASED VERSION
// Undertale 背包视图布局 - 新版基于 FRE 的版本
//
// This is a modernized version using the new FRE-based visibility system:
// - Uses `visible_when` instead of `visibility_rule`
// - Uses `initial_facts` instead of `interactive_layers`
// - Cursor position driven by facts instead of `reactive_indicator`
//
// 这是使用新的基于 FRE 的可见性系统的现代化版本：
// - 使用 `visible_when` 代替 `visibility_rule`
// - 使用 `initial_facts` 代替 `interactive_layers`
// - 光标位置由 fact 驱动而非 `reactive_indicator`
//
// DEPTH MAPPING / 深度映射:
// - depth 0: Main menu (ITEM/STAT)
// - depth 1: Item list
// - depth 2: Item options (USE/INFO/DROP)
// - depth 3: Status page

(
    version: 2,  // New version for FRE-based system

    // View-local facts initialized when this layout is spawned
    // View 局部事实，在此布局生成时初始化
    initial_facts: {
        "depth": 0,
        "selection": 0,
        "active": true,
    },

    roots: [
        // ========================================
        // MENU BOX (ITEM/STAT) - Always visible
        // 菜单框（物品/状态）- 始终可见
        // ========================================
        (
            name: "MenuBox",
            visible_when: "true",  // Always visible when backpack is open
            ui_shape_logic: (
                width: 65.0,
                height: 68.0,
                border_width: 3.0,
                offset: (-108.5, -1.0, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "MenuTextItem",
                    content: "{{overworld/ui:ITEM}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-9.5, 28.25, 1.0),
                    ),
                    line_height: 1.375,
                    conditional_style: (
                        condition: "player.inventory.is_empty",
                        color: (0.5, 0.5, 0.5, 1.0),
                    ),
                ),
                (
                    id: "MenuTextStat",
                    content: "{{overworld/ui:STAT}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-9.5, 10.25, 1.0),
                    ),
                    line_height: 1.375,
                ),
            ],
            children: [],
        ),

        // ========================================
        // MENU CURSOR - Visible only at depth 0
        // 菜单光标 - 仅在深度 0 时可见
        // ========================================
        (
            name: "MenuCursor",
            visible_when: "$depth == 0",
            sprite: (
                visual: (path: "common/heartsmall"),
                // Position calculated by expression: origin + step * selection
                // 位置由表达式计算：origin + step * selection
                transform: (
                    translation: (
                        "-19.0",                          // X: fixed
                        "18.5 + (-18.0 * $selection)",   // Y: origin + step * selection
                        "2.0",                            // Z: fixed
                    ),
                ),
            ),
        ),

        // ========================================
        // INFO BOX (Name, LV, HP, Gold) - Always visible
        // 信息框（名称、等级、HP、金币）- 始终可见
        // ========================================
        (
            name: "InfoBox",
            visible_when: "true",
            ui_shape_logic: (
                width: 65.0,
                height: 49.0,
                border_width: 3.0,
                offset: (-108.5, -68.5, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "NameText",
                    content: "{@player.name}",
                    font: DeterminationSans,
                    world_scale: (13.0, 13.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-28.5, 22.0, 1.0),
                    ),
                    line_height: 1.0,
                ),
                (
                    id: "HUDText",
                    content: "{{overworld/ui:LV}}  {@player.lv}\n{{overworld/ui:HP}}  {@player.hp}/{@player.hp_max}\ng   {@player.gold}",
                    font: Hud,
                    world_scale: (8.0, 8.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-28.5, 5.75, 1.0),
                    ),
                    line_height: 1.125,
                ),
            ],
            children: [],
        ),

        // ========================================
        // ITEM BOX - Visible at depth 1 or 2
        // 物品框 - 在深度 1 或 2 时可见
        // ========================================
        (
            name: "ItemBox",
            visible_when: "$depth == 1 || $depth == 2",
            ui_shape_logic: (
                width: 167.0,
                height: 175.0,
                border_width: 3.0,
                offset: (20.5, 3.5, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "ItemLayerList",
                    content: "{@player.inventory}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-64.25, 76.5, 1.0),
                    ),
                    line_height: 1.2,
                ),
                (
                    id: "ItemLayerOptionUse",
                    content: "{{overworld/ui:USE}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-64.25, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                    visible_when: "$depth == 2",
                ),
                (
                    id: "ItemLayerOptionInfo",
                    content: "{{overworld/ui:INFO}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-12.25, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                    visible_when: "$depth == 2",
                ),
                (
                    id: "ItemLayerOptionDrop",
                    content: "{{overworld/ui:DROP}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (40.75, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                    visible_when: "$depth == 2",
                ),
            ],
            children: [],
        ),

        // ========================================
        // ITEM LIST CURSOR - Visible at depth 1
        // 物品列表光标 - 在深度 1 时可见
        // ========================================
        (
            name: "ItemCursor",
            visible_when: "$depth == 1",
            sprite: (
                visual: (path: "common/heartsmall"),
                transform: (
                    translation: (
                        "-72.0",                          // X: fixed
                        "68.0 + (-16.0 * $selection)",   // Y: origin + step * selection
                        "2.0",                            // Z: fixed
                    ),
                ),
            ),
        ),

        // ========================================
        // ITEM OPTIONS CURSOR - Visible at depth 2
        // 物品选项光标 - 在深度 2 时可见
        // ========================================
        (
            name: "OptionsCursor",
            visible_when: "$depth == 2",
            sprite: (
                visual: (path: "common/heartsmall"),
                // Position based on selection: 0=USE, 1=INFO, 2=DROP
                // 位置基于选择：0=使用，1=信息，2=丢弃
                transform: (
                    translation: (
                        // X positions: -72, -24, 33 for indices 0, 1, 2
                        "if($selection == 0, -72.0, if($selection == 1, -24.0, 33.0))",
                        "-72.0",                          // Y: fixed
                        "2.0",                            // Z: fixed
                    ),
                ),
            ),
        ),

        // ========================================
        // STATUS BOX - Visible at depth 3
        // 状态框 - 在深度 3 时可见
        // ========================================
        (
            name: "StatusBox",
            visible_when: "$depth == 3",
            ui_shape_logic: (
                width: 167.0,
                height: 202.5,
                border_width: 3.0,
                offset: (20.5, -10.5, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "StatusLayerName",
                    content: "\"{@player.name}\"",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 88.25, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerLvHp",
                    content: "{{overworld/ui:LV}}   {@player.lv}\n{{overworld/ui:HP}}  {@player.hp} / {@player.hp_max}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 57.75, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerCombat",
                    content: "{{overworld/ui:ATK}}  {@player.total_attack} ({@player.weapon_atk})            {{overworld/ui:EXP}}: {@player.exp}\n{{overworld/ui:DEF}}  {@player.total_defense} ({@player.armor_def})            {{overworld/ui:NEXT}}: {@player.next_exp}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 10.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerEquipment",
                    content: "{{overworld/ui:WEAPON}}: {@player.weapon}\n{{overworld/ui:ARMOR}}: {@player.armor}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, -36.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerGold",
                    content: "{{overworld/ui:GOLD}}: {@player.gold}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, -72.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
            ],
            children: [],
        ),
    ],

    // Global triggers remain for state machine integration
    // 全局触发器保留用于状态机集成
    global_triggers: {
        "Menu": [
            (
                target_state: "Backpack",
                sound: None,
                allowed_states: ["Normal"],
            ),
            (
                target_state: "Normal",
                sound: None,
                allowed_states: ["Backpack"],
            ),
        ],
    },
)
