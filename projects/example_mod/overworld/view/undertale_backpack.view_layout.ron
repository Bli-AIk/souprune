#![enable(implicit_some)]
// Undertale Backpack View Layout
// Undertale 背包视图布局
//
// View system features used in this layout:
// 此布局使用的视图系统特性：
// - `visible_when`: Expression-based visibility control
// - `initial_facts`: View-local state initialization
// - Dynamic transforms: Expression-driven cursor positioning
//
// DEPTH MAPPING / 深度映射:
// - depth 0: Main menu (ITEM/STAT)
// - depth 1: Item list
// - depth 2: Item options (USE/INFO/DROP)
// - depth 3: Status page
//
// NOTE: Navigation is handled by view_local_facts_navigation_system in overworld/view.rs
// 注意：导航由 overworld/view.rs 中的 view_local_facts_navigation_system 处理

(
    version: 2,

    // View-local facts initialized when this layout is spawned
    // View 局部事实，在此布局生成时初始化
    initial_facts: {
        "depth": 0,
        "selection": 0,
        "active": true,
    },

    roots: [
        // ========================================
        // MENU BOX (ITEM/STAT) - Always visible
        // 菜单框（物品/状态）- 始终可见
        // ========================================
        (
            name: "MenuBox",
            visible_when: "true",  // Always visible when backpack is open
            ui_shape_logic: (
                width: 65.0,
                height: 68.0,
                border_width: 3.0,
                offset: (-108.5, -1.0, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "MenuTextItem",
                    content: "{{overworld/ui:ITEM}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-9.5, 28.25, 1.0),
                    ),
                    line_height: 1.375,
                    conditional_style: (
                        condition: "player.inventory.is_empty",
                        color: (0.5, 0.5, 0.5, 1.0),
                    ),
                ),
                (
                    id: "MenuTextStat",
                    content: "{{overworld/ui:STAT}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-9.5, 10.25, 1.0),
                    ),
                    line_height: 1.375,
                ),
            ],
            // Menu cursor as child of MenuBox for proper positioning
            // 菜单光标作为 MenuBox 的子物体以正确定位
            children: [
                (
                    name: "MenuCursor",
                    visible_when: "$depth == 0",
                    sprite: (
                        visual: "common/ui/heartsmall",
                        color: (1.0, 0.0, 0.0, 1.0),  // Red heart / 红心
                        // Position relative to MenuBox center
                        // 相对于 MenuBox 中心的位置
                        // ITEM text at Y=28.25, cursor 10px left of text at X=-19.5
                        // Step between options: 18.0 pixels
                        transform: (
                            translation: ("-19.0", "18.5 + (-18.0 * $selection)", "6.0"),
                        ),
                    ),
                ),
            ],
        ),

        // ========================================
        // INFO BOX (Name, LV, HP, Gold) - Always visible
        // 信息框（名称、等级、HP、金币）- 始终可见
        // ========================================
        (
            name: "InfoBox",
            visible_when: "true",
            ui_shape_logic: (
                width: 65.0,
                height: 49.0,
                border_width: 3.0,
                offset: (-108.5, -68.5, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "NameText",
                    content: "{@player.name}",
                    font: DeterminationSans,
                    world_scale: (13.0, 13.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-28.5, 22.0, 1.0),
                    ),
                    line_height: 1.0,
                ),
                (
                    id: "HUDText",
                    content: "{{overworld/ui:LV}}  {@player.lv}\n{{overworld/ui:HP}}  {@player.hp}/{@player.hp_max}\ng   {@player.gold}",
                    font: Hud,
                    world_scale: (8.0, 8.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-28.5, 5.75, 1.0),
                    ),
                    line_height: 1.125,
                ),
            ],
            children: [],
        ),

        // ========================================
        // ITEM BOX - Visible at depth 1 or 2
        // 物品框 - 在深度 1 或 2 时可见
        // ========================================
        (
            name: "ItemBox",
            visible_when: "$depth == 1 || $depth == 2",
            ui_shape_logic: (
                width: 167.0,
                height: 175.0,
                border_width: 3.0,
                offset: (20.5, 3.5, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "ItemLayerList",
                    content: "{@player.inventory}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-64.25, 76.5, 1.0),
                    ),
                    line_height: 1.2,
                ),
                (
                    id: "ItemLayerOptionUse",
                    content: "{{overworld/ui:USE}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-64.25, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                    visible_when: "$depth == 2",
                ),
                (
                    id: "ItemLayerOptionInfo",
                    content: "{{overworld/ui:INFO}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-16.25, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                    visible_when: "$depth == 2",
                ),
                (
                    id: "ItemLayerOptionDrop",
                    content: "{{overworld/ui:DROP}}",
                    font: DeterminationSans,
                    world_scale: (13.25, 13.25),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (40.75, -63.5, 1.0),
                    ),
                    line_height: 1.2,
                    visible_when: "$depth == 2",
                ),
            ],
            // Item cursors as children of ItemBox for proper positioning
            // 物品光标作为 ItemBox 的子物体以正确定位
            children: [
                // Item list cursor - visible at depth 1
                // 物品列表光标 - 在深度 1 时可见
                (
                    name: "ItemCursor",
                    visible_when: "$depth == 1",
                    sprite: (
                        visual: "common/ui/heartsmall",
                        color: (1.0, 0.0, 0.0, 1.0),  // Red heart / 红心
                        // Position relative to ItemBox center
                        // First item text at Y=76.5, cursor 10px left of text at X=-74.25
                        // Step between items: 16 pixels
                        transform: (
                            translation: (
                                "-72.0",                          // X: left of item list text
                                "68 + (-16.0 * $selection)",    // Y: First item position + step * selection
                                "6.0",                             // Z: above box
                            ),
                        ),
                    ),
                ),
                // Item options cursor - visible at depth 2
                // 物品选项光标 - 在深度 2 时可见
                (
                    name: "OptionsCursor",
                    visible_when: "$depth == 2",
                    sprite: (
                        visual: "common/ui/heartsmall",
                        color: (1.0, 0.0, 0.0, 1.0),  // Red heart / 红心
                        // Position relative to ItemBox center based on selection: 0=USE, 1=INFO, 2=DROP
                        // USE at X=-64.25, INFO at X=-12.25, DROP at X=40.75
                        // Cursor 10px left of each text
                        transform: (
                            translation: (
                                // X positions: -74.25, -22.25, 30.75 for indices 0, 1, 2
                                "if($selection == 0, -74.25, if($selection == 1, -22.25, 30.75))",
                                "-63.5",                          // Y: same as option texts
                                "6.0",                            // Z: above box
                            ),
                        ),
                    ),
                ),
            ],
        ),

        // ========================================
        // STATUS BOX - Visible at depth 3
        // 状态框 - 在深度 3 时可见
        // ========================================
        (
            name: "StatusBox",
            visible_when: "$depth == 3",
            ui_shape_logic: (
                width: 167.0,
                height: 202.5,
                border_width: 3.0,
                offset: (20.5, -10.5, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "StatusLayerName",
                    content: "\"{@player.name}\"",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 88.25, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerLvHp",
                    content: "{{overworld/ui:LV}}   {@player.lv}\n{{overworld/ui:HP}}  {@player.hp} / {@player.hp_max}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 57.75, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerCombat",
                    content: "{{overworld/ui:ATK}}  {@player.total_attack} ({@player.weapon_atk})            {{overworld/ui:EXP}}: {@player.exp}\n{{overworld/ui:DEF}}  {@player.total_defense} ({@player.armor_def})            {{overworld/ui:NEXT}}: {@player.next_exp}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, 10.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerEquipment",
                    content: "{{overworld/ui:WEAPON}}: {@player.weapon}\n{{overworld/ui:ARMOR}}: {@player.armor}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, -36.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
                (
                    id: "StatusLayerGold",
                    content: "{{overworld/ui:GOLD}}: {@player.gold}",
                    font: DeterminationSans,
                    world_scale: (13.5, 13.5),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-72.5, -72.0, 1.0),
                    ),
                    line_height: 1.15,
                ),
            ],
            children: [],
        ),
    ],

    // Global triggers remain for state machine integration
    // 全局触发器保留用于状态机集成
    global_triggers: {
        "Menu": [
            (
                target_state: "Backpack",
                sound: None,
                allowed_states: ["Normal"],
            ),
            (
                target_state: "Normal",
                sound: None,
                allowed_states: ["Backpack"],
            ),
        ],
    },
)
