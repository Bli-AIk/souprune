// Generic narration sequence
// 通用旁白序列
//
// This sequence displays a narration message and waits for player confirmation.
// The narration text is determined by the `action_param` fact, which is set
// by FRE rules before running this sequence.
//
// 此序列显示旁白消息并等待玩家确认。
// 旁白文本由 `action_param` fact 确定，该 fact 在运行此序列前由 FRE 规则设置。
//
// Prerequisites / 前置条件:
//   - action_param: The Mortar localization key for the narration text (set by FRE)
//
// This is a reusable template for any "show text → wait → continue" pattern.
// 这是任何"显示文本 → 等待 → 继续"模式的可复用模板。
(chapters: [
    // First set narration_visible BEFORE depth to prevent intro dialogue replay
    // 先设置 narration_visible 再设置 depth，防止开场对话重播
    SetViewFact(key: "narration_visible", value: Bool(true)),
    SetViewFact(key: "buttons_visible", value: Bool(false)),
    SetViewFact(key: "depth", value: Int(0)),

    // Wait for player to press confirm
    // 等待玩家按确认键
    AwaitFact(condition: "$confirm_pressed == true"),
    SetViewFact(key: "confirm_pressed", value: Bool(false)),

    // Hide narration, restore UI
    // 隐藏旁白，恢复 UI
    SetViewFact(key: "narration_visible", value: Bool(false)),
    SetViewFact(key: "buttons_visible", value: Bool(true)),
])
