(
    version: 1,
    roots: [
        // Battle Box (Dialog/Bullet Box)
        (
            name: "BattleBox",
            tags: ["BattleBox"],
            ui_shape_logic: Some((
                width: 566.0,
                height: 130.0,
                border_width: 5.0,
                offset: (x: 0.0, y: -80.0, z: 0.0),
                // Use classic UIBox structure (Border + Filler)
                structure_file: Some("shared/ui_structures/ui_box.smud.ron"),
            )),
            // Optional: Add HP bar or text here later
            children: [],
        ),

        // Fight Button
        (
            name: "BtnFight",
            sprite: Some((
                path: "textures/battle/ui/fight/false.png",
                is_animation: false,
                transform: Some((
                    translation: (x: -233.0, y: -213.0, z: 1.0),
                    scale: Some((x: 1.0, y: 1.0, z: 1.0)),
                )),
            )),
        ),

        // Act Button
        (
            name: "BtnAct",
            sprite: Some((
                path: "textures/battle/ui/act/false.png",
                is_animation: false,
                transform: Some((
                    translation: (x: -80.0, y: -213.0, z: 1.0),
                    scale: Some((x: 1.0, y: 1.0, z: 1.0)),
                )),
            )),
        ),

        // Item Button
        (
            name: "BtnItem",
            sprite: Some((
                path: "textures/battle/ui/item/false.png",
                is_animation: false,
                transform: Some((
                    translation: (x: 80.0, y: -213.0, z: 1.0),
                    scale: Some((x: 1.0, y: 1.0, z: 1.0)),
                )),
            )),
        ),

        // Mercy Button
        (
            name: "BtnMercy",
            sprite: Some((
                path: "textures/battle/ui/mercy/false.png",
                is_animation: false,
                transform: Some((
                    translation: (x: 235.0, y: -213.0, z: 1.0),
                    scale: Some((x: 1.0, y: 1.0, z: 1.0)),
                )),
            )),
        ),

        // HUD Info - Pure container node (no visible box, just texts and children)
        // HUD 信息 - 纯容器节点（无可见框，只有文本和子节点）
        (
            name: "BattleHUD",
            // 重构后不再需要 0x0 的 ui_shape_logic hack
            // After refactoring, the 0x0 ui_shape_logic hack is no longer needed
            texts: [
                (
                    id: "PlayerName",
                    content: Some("{@player.name}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -290.0, y: -155.5, z: 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelLabel",
                    content: Some("{{battle/ui:LV}}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -187.5, y: -155.5, z: 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelValue",
                    content: Some("{@player.lv}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -148.5, y: -155.5, z: 1.0),
                    ),
                ),
                (
                    id: "HPValueCurrent",
                    content: Some("{@player.hp}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "-5.5 + (@player.hp_max - 20) * 94.5 / 79", y: -155.5, z: 1.0),
                    ),
                ),
                (
                    id: "HPSeparator",
                    content: Some("/"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "33.5 + (@player.hp_max - 20) * 94.5 / 79", y: -155.5, z: 1.0),
                    ),
                ),
                (
                    id: "HPValueMax",
                    content: Some("{@player.hp_max}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: "57.5 + (@player.hp_max - 20) * 94.5 / 79", y: -155.5, z: 1.0),
                    ),
                ),
            ],
            children: [
                (
                    name: "HPSprite",
                    sprite: Some((
                        path: "textures/battle/ui/hpname.png",
                        is_animation: false,
                        transform: Some((
                            translation: (x: -64.5, y: -170.0, z: 1.0),
                        )),
                    )),
                ),
                (
                    name: "HPBar",
                    sprite: Some((
                        path: "procedural://white_pixel",  // Use procedural texture
                        is_animation: false,
                        transform: Some((
                            translation: (x: -45.0, y: -170.5, z: 1.0),  // Move left, behind text (z=1)
                            scale: Some((x: "25.0 + (@player.hp_max - 20) * 95.0 / 79", y: 20.5, z: 1.0)),  // Dynamic width based on hp_max
                        )),
                        custom_shader: Some("shaders/hp_bar_sprite.wgsl"),
                        shader_params: Some((r: 0.8, g: 0.8, b: "40.0 + (@player.hp_max - 20) * 95.0 / 79 / 2", a: 1.0)),  // HP%, lag%, half_width (dynamic), alpha
                        pivot: Some((x: 0.0, y: 0.5)),
                    )),
                )
            ],
        ),
    ]
)
