(
    version: 1,
    roots: [
        // Battle Box (Dialog/Bullet Box)
        (
            name: "BattleBox",
            tags: ["BattleBox"],
            ui_shape_logic: Some((
                width: 566.0,
                height: 130.0,
                border_width: 5.0,
                offset: (x: 0.0, y: -80.0, z: 0.0),
                // Use classic UIBox structure (Border + Filler)
                structure_file: Some("shared/ui_structures/ui_box.smud.ron"),
            )),
            // Optional: Add HP bar or text here later
            children: [],
        ),

        // Fight Button
        (
            name: "BtnFight",
            sprite: Some((
                path: "textures/battle/ui/fight/false.png",
                is_animation: false,
                transform: Some((
                    translation: (x: -233.0, y: -213.0, z: 1.0),
                    scale: Some((x: 1.0, y: 1.0, z: 1.0)),
                )),
            )),
        ),

        // Act Button
        (
            name: "BtnAct",
            sprite: Some((
                path: "textures/battle/ui/act/false.png",
                is_animation: false,
                transform: Some((
                    translation: (x: -80.0, y: -213.0, z: 1.0),
                    scale: Some((x: 1.0, y: 1.0, z: 1.0)),
                )),
            )),
        ),

        // Item Button
        (
            name: "BtnItem",
            sprite: Some((
                path: "textures/battle/ui/item/false.png",
                is_animation: false,
                transform: Some((
                    translation: (x: 80.0, y: -213.0, z: 1.0),
                    scale: Some((x: 1.0, y: 1.0, z: 1.0)),
                )),
            )),
        ),

        // Mercy Button
        (
            name: "BtnMercy",
            sprite: Some((
                path: "textures/battle/ui/mercy/false.png",
                is_animation: false,
                transform: Some((
                    translation: (x: 235.0, y: -213.0, z: 1.0),
                    scale: Some((x: 1.0, y: 1.0, z: 1.0)),
                )),
            )),
        ),

        // HUD Info - Pure container node (no visible box, just texts and children)
        // HUD 信息 - 纯容器节点（无可见框，只有文本和子节点）
        (
            name: "BattleHUD",
            // 重构后不再需要 0x0 的 ui_shape_logic hack
            // After refactoring, the 0x0 ui_shape_logic hack is no longer needed
            texts: [
                (
                    id: "PlayerName",
                    content: Some("{@player.name}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -290.0, y: -155.0, z: 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelLabel",
                    content: Some("{{battle/ui:LV}}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -187.5, y: -155.0, z: 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelValue",
                    content: Some("{@player.lv}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -148.5, y: -155.0, z: 1.0),
                    ),
                ),
                (
                    id: "HPValueCurrent",
                    content: Some("{@player.hp}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: -5.5, y: -155.0, z: 1.0),
                    ),
                ),
                (
                    id: "HPSeparator",
                    content: Some("/"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: 33.5, y: -155.0, z: 1.0),
                    ),
                ),
                (
                    id: "HPValueMax",
                    content: Some("{@player.hp_max}"),
                    font: BattleHud,
                    world_scale: (x: 24.0, y: 24.0),
                    color: (r: 1.0, g: 1.0, b: 1.0, a: 1.0),
                    transform: (
                        translation: (x: 57.5, y: -155.0, z: 1.0),
                    ),
                ),
            ],
            children: [
                (
                    name: "HPSprite",
                    sprite: Some((
                        path: "textures/battle/ui/hpname.png",
                        is_animation: false,
                        transform: Some((
                            translation: (x: -64.5, y: -170.0, z: 1.0),
                        )),
                    )),
                ),
                (
                    name: "HPBar",
                    ui_shape_logic: Some((
                        width: 100.0,
                        height: 20.0,
                        offset: (x: 0.0, y: -170.0, z: 1.0),
                        fill_shader: Some("shared/shaders/hp_bar.wgsl"),
                        // No structure_file = single layer SmudShape (default)
                        // fill_color is used as data bus for HP bar shader:
                        // r = current HP%, g = delayed HP%, b = width, a = height
                        fill_color: Some((r: 0.5, g: 0.5, b: 100.0, a: 20.0)),
                    )),
                )
            ],
        ),
    ]
)
