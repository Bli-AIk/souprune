#![enable(implicit_some)]
// Undertale Battle View Layout
// Undertale 战斗视图布局
//
// View system features used in this layout:
// 此布局使用的视图系统特性：
// - `visible_when`: Expression-based visibility control
// - `initial_facts`: View-local state initialization
// - `state_sprite`: Data-driven button highlighting
//
// NOTE: Navigation is handled by battle_view_navigation_system in battle/fre/bridge.rs
// 注意：导航由 battle/fre/bridge.rs 中的 battle_view_navigation_system 处理

(
    version: 2,

    // View-local facts for battle menu state
    // 战斗菜单状态的 View 局部事实
    initial_facts: {
        "depth": 0,           // 0=main menu, 1=submenu
        "selection": 0,       // Current selection: 0=FIGHT, 1=ACT, 2=ITEM, 3=MERCY
        "active": true,       // Whether menu is active (vs bullet hell)
    },

    roots: [
        // ========================================
        // BATTLE BOX (Dialog/Bullet Box)
        // 战斗框（对话/弹幕框）
        // ========================================
        (
            name: "BattleBox",
            tags: ["BattleBox"],
            ui_shape_logic: (
                width: 566.0,
                height: 130.0,
                border_width: 5.0,
                offset: (0.0, -80.0, 0.0),
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            texts: [
                (
                    id: "BattleDialogue",
                    content: "{{battle/ui:ENEMY_APPEARED}}",
                    font: DeterminationMono,
                    world_scale: (26.0, 26.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-267.0, 50.0, 1.0),
                    ),
                    line_height: 1.2,
                    // Only show in main menu (depth 0)
                    // 仅在主菜单（深度 0）时显示
                    visible_when: "$depth == 0",
                ),
            ],
            children: [],
        ),

        // ========================================
        // BATTLE MENU CURSOR
        // 战斗菜单光标
        // ========================================
        (
            name: "MenuCursor",
            visible_when: "$depth == 0 && $active",
            sprite: (
                visual: "common/ui/heart",
                color: (1.0, 0.0, 0.0, 1.0),  // Red heart / 红心
                // Position based on selection: 0=FIGHT, 1=ACT, 2=ITEM, 3=MERCY
                // 位置基于选择：0=战斗，1=行动，2=物品，3=慈悲
                transform: (
                    translation: (
                        // X positions: -258, -105, 55, 210 for indices 0, 1, 2, 3
                        "if($selection == 0, -258.0, if($selection == 1, -105.0, if($selection == 2, 55.0, 210.0)))",
                        "-213.0",
                        "2.0",
                    ),
                ),
            ),
        ),

        // ========================================
        // FIGHT BUTTON
        // 战斗按钮
        // ========================================
        (
            name: "BtnFight",
            // Use conditional sprite based on selection
            // 根据选择使用条件精灵
            sprite: (
                // Note: In v2, we'd ideally have a conditional visual system
                // For now, this shows the default; a proper implementation would
                // need visible_when on separate sprites or a new conditional_visual field
                // 注意：在 v2 中，我们理想地需要一个条件视觉系统
                // 目前这显示默认值；正确的实现需要在单独的精灵上使用 visible_when
                // 或一个新的 conditional_visual 字段
                visual: "textures/battle/ui/fight/false.png",
                transform: (
                    translation: (-233.0, -213.0, 1.0),
                ),
            ),
        ),
        // FIGHT button selected state
        (
            name: "BtnFightSelected",
            visible_when: "$selection == 0",
            sprite: (
                visual: "textures/battle/ui/fight/true.png",
                transform: (
                    translation: (-233.0, -213.0, 1.5),  // Slightly higher z to overlay
                ),
            ),
        ),

        // ========================================
        // ACT BUTTON
        // 行动按钮
        // ========================================
        (
            name: "BtnAct",
            sprite: (
                visual: "textures/battle/ui/act/false.png",
                transform: (
                    translation: (-80.0, -213.0, 1.0),
                ),
            ),
        ),
        (
            name: "BtnActSelected",
            visible_when: "$selection == 1",
            sprite: (
                visual: "textures/battle/ui/act/true.png",
                transform: (
                    translation: (-80.0, -213.0, 1.5),
                ),
            ),
        ),

        // ========================================
        // ITEM BUTTON
        // 物品按钮
        // ========================================
        (
            name: "BtnItem",
            sprite: (
                visual: "textures/battle/ui/item/false.png",
                transform: (
                    translation: (80.0, -213.0, 1.0),
                ),
            ),
        ),
        (
            name: "BtnItemSelected",
            visible_when: "$selection == 2",
            sprite: (
                visual: "textures/battle/ui/item/true.png",
                transform: (
                    translation: (80.0, -213.0, 1.5),
                ),
            ),
        ),

        // ========================================
        // MERCY BUTTON
        // 慈悲按钮
        // ========================================
        (
            name: "BtnMercy",
            sprite: (
                visual: "textures/battle/ui/mercy/false.png",
                transform: (
                    translation: (235.0, -213.0, 1.0),
                ),
            ),
        ),
        (
            name: "BtnMercySelected",
            visible_when: "$selection == 3",
            sprite: (
                visual: "textures/battle/ui/mercy/true.png",
                transform: (
                    translation: (235.0, -213.0, 1.5),
                ),
            ),
        ),

        // ========================================
        // HUD INFO
        // HUD 信息
        // ========================================
        (
            name: "BattleHUD",
            texts: [
                (
                    id: "PlayerName",
                    content: "{@player.name}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-290.0, -155.5, 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelLabel",
                    content: "{{battle/ui:LV}}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-187.5, -155.5, 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelValue",
                    content: "{@player.lv}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-148.5, -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPValueCurrent",
                    content: "{@player.hp}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("-5.5 + (@player.hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPSeparator",
                    content: "/",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("33.5 + (@player.hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPValueMax",
                    content: "{@player.hp_max}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("57.5 + (@player.hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
            ],
            children: [
                (
                    name: "HPSprite",
                    sprite: (
                        visual: "textures/battle/ui/hpname.png",
                        transform: (
                            translation: (-64.5, -170.0, 1.0),
                        ),
                    ),
                ),
                (
                    name: "HPBar",
                    sprite: (
                        visual: "procedural://white_pixel",
                        transform: (
                            translation: (-45.0, -170.5, 1.0),
                            scale: ("25.0 + (@player.hp_max - 20) * 95.0 / 79", 20.5, 1.0),
                        ),
                        custom_shader: "shaders/hp_bar_sprite.wgsl",
                        shader_params: (0.8, 0.8, "40.0 + (@player.hp_max - 20) * 95.0 / 79 / 2", 1.0),
                        pivot: (0.0, 0.5),
                    ),
                )
            ],
        ),
    ],
)
