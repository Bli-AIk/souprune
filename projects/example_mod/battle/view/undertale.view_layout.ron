#![enable(implicit_some)]
(
    version: 1,
    roots: [
        // Battle Box (Dialog/Bullet Box)
        (
            name: "BattleBox",
            tags: ["BattleBox"],
            ui_shape_logic: (
                width: 566.0,
                height: 130.0,
                border_width: 5.0,
                offset: (0.0, -80.0, 0.0),
                // Use classic UIBox structure (Border + Filler)
                structure_file: "shared/ui_structures/ui_box.sdf.ron",
            ),
            // Battle dialogue text
            texts: [
                (
                    id: "BattleDialogue",
                    content: "{{battle/ui:ENEMY_APPEARED}}",
                    font: DeterminationMono,
                    world_scale: (26.0, 26.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-267.0, 50.0, 1.0),
                    ),
                    line_height: 1.2,
                ),
            ],
            // Reactive indicator (heart cursor) for main menu selection
            reactive_indicator: (
                sprite_path: "common/heart",
                default_translation: Some(Custom(
                    positions: [
                        // FIGHT position (button center -233, cursor offset ~25px left)
                        (-258.0, -213.0, 2.0),
                        // ACT position (button center -80)
                        (-105.0, -213.0, 2.0),
                        // ITEM position (button center 80)
                        (55.0, -213.0, 2.0),
                        // MERCY position (button center 235)
                        (210.0, -213.0, 2.0),
                    ],
                )),
                visibility_rule: (
                    rule_type: "OnlyIn",
                    layers: ["BattleMainMenu"],
                ),
                transform: (
                    scale: (1.0, 1.0, 1.0),
                ),
            ),
            // Optional: Add HP bar or text here later
            children: [],
        ),

        // Fight Button - using data-driven state_sprite
        // 战斗按钮 - 使用数据驱动的 state_sprite
        (
            name: "BtnFight",
            state_sprite: (
                default: "textures/battle/ui/fight/false.png",
                variants: {
                    "selected": "textures/battle/ui/fight/true.png",
                },
                // Sugar syntax: subscribe to BattleMainMenu selection at index 0
                // 语法糖：订阅 BattleMainMenu 选中状态，索引 0
                subscribe_selection: ("BattleMainMenu", 0),
                transform: (
                    translation: (-233.0, -213.0, 1.0),
                    scale: (1.0, 1.0, 1.0),
                ),
            ),
        ),

        // Act Button - using data-driven state_sprite
        // 行动按钮 - 使用数据驱动的 state_sprite
        (
            name: "BtnAct",
            state_sprite: (
                default: "textures/battle/ui/act/false.png",
                variants: {
                    "selected": "textures/battle/ui/act/true.png",
                },
                subscribe_selection: ("BattleMainMenu", 1),
                transform: (
                    translation: (-80.0, -213.0, 1.0),
                    scale: (1.0, 1.0, 1.0),
                ),
            ),
        ),

        // Item Button - using data-driven state_sprite
        // 物品按钮 - 使用数据驱动的 state_sprite
        (
            name: "BtnItem",
            state_sprite: (
                default: "textures/battle/ui/item/false.png",
                variants: {
                    "selected": "textures/battle/ui/item/true.png",
                },
                subscribe_selection: ("BattleMainMenu", 2),
                transform: (
                    translation: (80.0, -213.0, 1.0),
                    scale: (1.0, 1.0, 1.0),
                ),
            ),
        ),

        // Mercy Button - using data-driven state_sprite
        // 慈悲按钮 - 使用数据驱动的 state_sprite
        (
            name: "BtnMercy",
            state_sprite: (
                default: "textures/battle/ui/mercy/false.png",
                variants: {
                    "selected": "textures/battle/ui/mercy/true.png",
                },
                subscribe_selection: ("BattleMainMenu", 3),
                transform: (
                    translation: (235.0, -213.0, 1.0),
                    scale: (1.0, 1.0, 1.0),
                ),
            ),
        ),

        // HUD Info - Pure container node (no visible box, just texts and children)
        // HUD 信息 - 纯容器节点（无可见框，只有文本和子节点）
        (
            name: "BattleHUD",
            // 重构后不再需要 0x0 的 ui_shape_logic hack
            // After refactoring, the 0x0 ui_shape_logic hack is no longer needed
            texts: [
                (
                    id: "PlayerName",
                    content: "{@player.name}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-290.0, -155.5, 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelLabel",
                    content: "{{battle/ui:LV}}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-187.5, -155.5, 1.0),
                    ),
                ),
                (
                    id: "PlayerLevelValue",
                    content: "{@player.lv}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: (-148.5, -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPValueCurrent",
                    content: "{@player.hp}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("-5.5 + (@player.hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPSeparator",
                    content: "/",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("33.5 + (@player.hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
                (
                    id: "HPValueMax",
                    content: "{@player.hp_max}",
                    font: BattleHud,
                    world_scale: (24.0, 24.0),
                    color: (1.0, 1.0, 1.0, 1.0),
                    transform: (
                        translation: ("57.5 + (@player.hp_max - 20) * 94.5 / 79", -155.5, 1.0),
                    ),
                ),
            ],
            children: [
                (
                    name: "HPSprite",
                    sprite: (
                        visual: "textures/battle/ui/hpname.png",
                        transform: (
                            translation: (-64.5, -170.0, 1.0),
                        ),
                    ),
                ),
                (
                    name: "HPBar",
                    sprite: (
                        visual: "procedural://white_pixel",  // Use procedural texture
                        transform: (
                            translation: (-45.0, -170.5, 1.0),  // Move left, behind text (z=1)
                            scale: ("25.0 + (@player.hp_max - 20) * 95.0 / 79", 20.5, 1.0),  // Dynamic width based on hp_max
                        ),
                        custom_shader: "shaders/hp_bar_sprite.wgsl",
                        shader_params: (0.8, 0.8, "40.0 + (@player.hp_max - 20) * 95.0 / 79 / 2", 1.0),  // HP%, lag%, half_width (dynamic), alpha
                        pivot: (0.0, 0.5),
                    ),
                )
            ],
        ),
    ],
    
    // Interactive layer definitions for battle menu navigation
    // 战斗菜单导航的交互层定义
    interactive_layers: {
        "BattleMainMenu": (
            // 1 row, 4 columns for FIGHT/ACT/ITEM/MERCY buttons
            // 1 行 4 列的 FIGHT/ACT/ITEM/MERCY 按钮
            navigator_type: Grid(
                rows: 1,
                cols: 4,
                looping: true,
            ),
            selectable_elements: ["BtnFight", "BtnAct", "BtnItem", "BtnMercy"],
            sound_on_navigate: "choice.wav",
            sound_on_confirm: "confirm.wav",
        ),
    },
)
