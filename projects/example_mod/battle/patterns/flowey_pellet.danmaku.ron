// Flowey Pellet Circle Pattern
// A circle of pellets that rotate and converge on the player
(
    visual: Animation(
        module: "battle",
        name: "flowey_pellet",
        frame_duration: 0.05,
    ),
    collider_radius: 8.0,
    damage: 1.0,
    lifetime: 5.0,
    z_index: 5.0,

    spawn_pattern: Circle(
        count: 12,
        radius: 120.0,
        start_angle: 0.0,
    ),

    motion_tracks: [
        // Track 1: Circular rotation around spawn center
        Circular(
            angular_velocity: 0.5,
            radial_velocity: -80.0,  // Contract towards center
        ),
    ],

    children: [],
)
