#![enable(implicit_some)]
// Battle configuration with FRE data loading
// 带有 FRE 数据加载的战斗配置
(
    // The sequence of chapters to execute
    // 要执行的章节序列
    chapters: [
        SetCamera(SetZoom(2.0)),

        // Spawn battle UI view with enemy data bound directly from FRE file
        // 生成战斗 UI 视图，敌人数据直接从 FRE 文件绑定
        SpawnView(
            view_layout: "battle/view/undertale.view_layout.ron",
            bindings: {
                // Directly bind enemy data from FRE file (no LoadFre needed)
                // 直接从 FRE 文件绑定敌人数据（无需 LoadFre）
                "enemies": File("battle/enemies/demo_enemies.fre.ron"),
            },
        ),
        AwaitInteraction(
            layer_id: "BattleMainMenu",
            initial_selection: 0,
        ),
        SetPlayer(Spawn(config_path: "battle/players/player.battle_player.ron", position: (0.0, -80.0))),

        TweenViewElement(
            selector: LocalName("BattleBox"),
            target: BoxSize(to: (130, "@current")),
            duration: 0.85,
            easing: QuadInOut,
            wait_for_completion: false,
        ),
        Wait(0.15),

        TweenViewElement(
            selector: LocalName("BattleBox"),
            target: Position(to: ("@current", "@current + 80", "@current")),
            duration: 1.0,
            easing: CubicOut,
            wait_for_completion: true,
        ),
        Wait(1.0),

        DanmakuPerformance(
            performance: "battle/danmaku/demo_attack.performance.ron",
            translation: Some((0.0, 50.0)),
        ),
        Wait(10.0),
        Sequence([
            Wait(0.5),
            SetPlayer(Despawn),// TODO: 实现这个功能
        ]),
        TweenViewElement(
            selector: LocalName("BattleBox"),
            target: BoxSize(from: (300.0, 100.0), to: (566.0, 130.0)),
            duration: 0.8,
            easing: ElasticOut,
            wait_for_completion: true,
        ),
    ],
)
