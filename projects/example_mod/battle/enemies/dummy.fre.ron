// Dummy enemy definition
// Dummy 敌人定义
//
// This file defines the Dummy enemy using FRE format.
// Facts are loaded when this enemy is added to a battle.
// Rules handle enemy-specific actions and behaviors.
//
// 此文件使用 FRE 格式定义 Dummy 敌人。
// 当此敌人被添加到战斗时，事实会被加载。
// 规则处理敌人特定的动作和行为。

(
    // Enemy data as initial facts
    // These are merged into the battle's fact database
    // 作为初始事实的敌人数据
    // 这些会被合并到战斗的事实数据库中
    facts: {
        // Basic enemy stats
        // 基本敌人属性
        "dummy.name": String("Dummy"),
        "dummy.hp": Int(100),
        "dummy.hp_max": Int(100),
        "dummy.attack": Int(0),
        "dummy.defense": Int(0),

        // Encounter description
        // 遭遇描述
        "dummy.description": String("A cotton heart and a button eye."),

        // ACT options count
        // ACT 选项数量
        "dummy.act_count": Int(4),

        // ACT name keys (Mortar localization keys)
        // ACT 名称键（Mortar 本地化键）
        "dummy.act_name_keys": StringList([
            "EnemyDummyActCheck",
            "EnemyDummyActTalk",
            "EnemyDummyActFlirt",
            "EnemyDummyActHug",
        ]),

        // ACT behaviors - defines what happens when each ACT is selected
        // Formats:
        //   "narration:NodeName" - Show narration from Mortar node, wait for confirm, end interaction
        //   "sequence:path" - Execute custom sequence file
        //   "end" - Just end interaction
        //
        // ACT 行为 - 定义选择每个 ACT 时发生的事情
        // 格式:
        //   "narration:节点名" - 显示 Mortar 节点的旁白，等待确认，结束交互
        //   "sequence:路径" - 执行自定义序列文件
        //   "end" - 直接结束交互
        "dummy.act_behaviors": StringList([
            "narration:EnemyDummyActCheckResult",
            "narration:EnemyDummyActTalkResult",
            "sequence:battle/acts/dummy/flirt.sequence.ron",
            "end",
        ]),
    },

    // Enemy-specific rules
    // These handle ACT options, damage reactions, etc.
    // 敌人特定规则
    // 处理行动选项、受伤反应等
    rules: [],
)
