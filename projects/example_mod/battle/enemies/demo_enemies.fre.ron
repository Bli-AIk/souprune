// Battle enemies data - directly used by battle UI
// 战斗敌人数据 - 直接被战斗 UI 使用
//
// This file contains aggregated enemy data for battle UI consumption.
// All arrays must have the same length.
//
// 此文件包含聚合的敌人数据，供战斗 UI 使用。
// 所有数组必须有相同的长度。

(
    facts: {
        // Enemy names (localized)
        // 敌人名称（本地化）
        "enemy_names": StringList([
            "{{battle/ui:ENEMY_TEST1}}",
            "{{battle/ui:ENEMY_TEST2}}",
            "{{battle/ui:ENEMY_TEST3}}",
            "{{battle/ui:ENEMY_TEST4}}",
            "{{battle/ui:ENEMY_TEST5}}",
        ]),

        // Current HP values
        // 当前生命值
        "enemy_hps": IntList([100, 80, 120, 60, 150]),

        // Maximum HP values
        // 最大生命值
        "enemy_hp_maxs": IntList([100, 100, 150, 80, 200]),

        // Attack values
        // 攻击值
        "enemy_attacks": IntList([5, 7, 10, 3, 15]),

        // Defense values
        // 防御值
        "enemy_defenses": IntList([3, 2, 5, 1, 8]),
    },
    rules: [],
)
