// Demo Battle Performance
// Demonstrates three attack patterns:
// 1. Spear linear attack
// 2. Pellet ring attack
// 3. Homing spear attack using mod algorithm

// 测试战斗表演
// 展示三种攻击模式：
// 1. 长矛线性攻击
// 2. 花颗粒一圈攻击
// 3. 长矛自机狙攻击（使用mod算法）
(
    // === Bullet Prototypes ===
    // === 弹幕原型 ===
    // We define our bullet "prefabs" here, including their visual representation, colliders, damage, and lifetime.
    // 我们在这里定义弹幕的"预制体"，包括它们的视觉表现、碰撞体、伤害值和生命周期。
    prototypes: {
        "spear": (
            // Use SpriteRef to reference sprite by name from config.toml
            // 使用 SpriteRef 通过 config.toml 中的名称引用精灵
            visual: SpriteRef(module: "battle", name: "spear"),
            collider: BoxCollider(3.0, 12.0),
            damage: 2.0,
            lifetime: 4.0,
            z_index: 15.0,
        ),
        "pellet": (
            visual: Animation(
                module: "battle",
                name: "flowey_pellet",
                frame_duration: 0.05,
            ),
            collider: BoxCollider(6.0, 6.0),
            damage: 1.0,
            lifetime: 5.0,
            z_index: 15.0,
        ),
    },

    // === Behavior Definitions ===
    // === 行为定义 ===
    // Here we define reusable behaviors that can be applied to bullets when they are spawned.
    // Note: Behaviors can also be defined inline in the timeline using the `behaviors` field.
    // 在这里我们定义可重用的行为，这些行为可以在弹幕生成时应用。
    // 请注意：行为也可以在时间线的 `behaviors` 字段中内联定义。
    behaviors: {
        // Linear movement to the right
        // 向右的线性移动
        "move_right": Linear((
            dir: (1.0, 0.0),
            speed: 200.0,
        )),

        // Linear movement to the left
        // 向左的线性移动
        "move_left": Linear((
            dir: (-1.0, 0.0),
            speed: 200.0,
        )),

        // Linear movement downward
        // 向下的线性移动
        "move_down": Linear((
            dir: (0.0, -1.0),
            speed: 150.0,
        )),

        // Orbital contraction toward center
        // 向中心收缩的轨道运动
        "spiral_in": Orbital((
            angular_velocity: 0.8,
            radial_velocity: -60.0,
        )),

        // Homing spear using mod algorithm
        // 通过 mod 算法实现的长矛自机狙
        "homing": Algo(
            id: "homing_spear",
            params: [180.0, 0.8],
        ),

        // Fade in effect
        // 淡入效果
        "fade_in": Tween((
            target: Opacity,
            duration: 2.0,
            ease: QuadOut,
            range: (0.0, 1.0),
            delay: 0.0,
        )),
    },

    // === Timeline ===
    // === 时间线 ===
    // This section defines the sequence of bullet spawns and their associated patterns and behaviors.
    // Time values are relative by default (delta from previous event). Set `absolute: true` for absolute time.
    // 这一部分定义了弹幕生成的顺序及其相关的模式和行为。
    // 时间值默认为相对时间（与上一事件的时间差）。设置 `absolute: true` 使用绝对时间。
    timeline: [
        // Step 1: Spear linear attack from left (t=0.0) - 长矛线性攻击
        // 第一步：从左侧发起的长矛线性攻击 (t=0.0)
        (
            t: 0.0,
            spawn: "spear",
            pattern: EdgeGenerator(count: 5, side: Left, spacing: 35.0, margin: 250.0),
            apply: ["move_right", "fade_in"],
        ),

        // Step 2: Pellet ring attack (t=1.5 after previous) - 花颗粒一圈攻击
        // 第二步：花颗粒一圈攻击 (距上一事件 1.5 秒)
        (
            t: 1.5,
            spawn: "pellet",
            pattern: RingGenerator(count: 12, radius: 100.0, start_angle: 0.0),
            apply: ["spiral_in", "fade_in"],
        ),

        // Step 3: Homing spears from top (t=2.0 after previous) - 长矛自机狙
        // 第三步：从顶部发起的长矛自机狙 (距上一事件 2.0 秒)
        (
            t: 2.0,
            spawn: "spear",
            pattern: LineGenerator(count: 3, spacing: 60.0, direction: (0.0, -1.0)),
            apply: ["homing", "fade_in"],
        ),

        // Step 4: Another pellet ring with inline behavior (t=1.5 after previous)
        // 第四步：另一个花颗粒一圈攻击，使用内联行为 (距上一事件 1.5 秒)
        (
            t: 1.5,
            spawn: "pellet",
            pattern: RingGenerator(count: 16, radius: 80.0, start_angle: 0.785),
            apply: ["spiral_in"],
            // Example of inline behavior - no need to define in behaviors map
            // 内联行为示例 - 无需在 behaviors 映射中定义
            behaviors: [
                Tween((
                    target: Scale,
                    duration: 1.0,
                    ease: QuadOut,
                    range: (0.5, 1.0),
                    delay: 0.0,
                )),
            ],
        ),

        // Step 5: Spear sweep from right (t=1.5 after previous)
        // 第五步：从右侧发起的长矛横扫 (距上一事件 1.5 秒)
        (
            t: 1.5,
            spawn: "spear",
            pattern: EdgeGenerator(count: 7, side: Right, spacing: 30.0, margin: 250.0),
            apply: ["move_left"],
        ),
    ],
)
