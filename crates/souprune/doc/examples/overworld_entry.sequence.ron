#![enable(implicit_some)]
// Overworld Entry Sequence Example / Overworld 入口序列示例
//
// This sequence is loaded when entering the Overworld state.
// It replaces the hardcoded OnEnter initialization systems.
//
// 当进入 Overworld 状态时加载此序列。
// 它替代了硬编码的 OnEnter 初始化系统。
(
    chapters: [
        // 1. Load the tilemap
        // 1. 加载瓦片地图
        LoadMap(
            path: "states/overworld/levels/ruins/ruins_3.tmx",
            generate_collision: true,
            process_objects: true,
            setup_camera_bounds: true,
        ),

        // 2. Spawn player at starting position
        // 2. 在起始位置生成玩家
        SetPlayer(Spawn(
            config_path: "states/overworld/players/player_battle.battle_player.ron",
            position: (160.0, 120.0),
        )),

        // 3. Set camera to follow player
        // 3. 设置相机跟随玩家
        SetCamera(FollowPlayer(true)),

        // 4. Start background music
        // 4. 播放背景音乐
        SetBgm(
            path: "bgm/ruins.ogg",
            fade_in: 1.0,
        ),
    ],
)
