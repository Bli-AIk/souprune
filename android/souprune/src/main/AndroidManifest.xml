<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.bliaik.souprune.permission.STORAGE"
        android:protectionLevel="signature" />

    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:theme="@style/SoupRuneTheme">

        <provider
            android:name="com.bliaik.souprune.StorageProvider"
            android:authorities="com.bliaik.souprune.storage"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="com.bliaik.souprune.permission.STORAGE" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:screenOrientation="landscape"
            android:theme="@style/SoupRuneTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data android:name="android.app.lib_name" android:value="souprune" />
        </activity>
    </application>
</manifest>
